# Copy this file to .env.local and fill in your own values.

# Paystack PUBLIC key (safe to expose client-side — never put the secret
# key here). Get it from https://dashboard.paystack.com under Settings > API Keys.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY

# Only used by `vite.config.ts`'s dev-server proxy, and only at dev-server
# start time (it's a Node env var, not a Vite client var). Point this at
# wherever your PHP backend actually runs. Examples:
#   XAMPP on the same machine:  http://localhost/stylish-trend
#   A different host/VM:        http://192.168.1.20:8080
VITE_API_PROXY_TARGET=http://localhost/stylish-trend
